    <a class="logo" href="/list">초록</a>
    <div class="nav-container">
    <div class="nav-list">
        <a href="/list">글 목록</a>
        <%if (user){%>
            <a href="/write">글 작성</a>
            <a href="/message/list">쪽지</a>
        <%}%>
