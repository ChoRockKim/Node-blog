                    <li><a href="/login">로그인</a></li>
                <%}%>
            </ul>
        </div>
    </div>
</div>

<script>
    const menuBtn = document.querySelector('.menu-btn')
    const menuBar = document.querySelector('.nav-list-mobile-content')
    menuBtn.addEventListener('click', () => {
        menuBar.classList.toggle('show')
    })
</script>