<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>초록</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body class="grey-bg">
  <%- include('nav.ejs')%>

  <div class="main-container">
  <div class="list-header"><span>게시글</span></div>
    <div class="category-container">
    <ul class="category-list">
      <a href="/"><li class="category-item category-activated">전체 (<%=post.totalPost%>)</li></a>
      <% for (let i=0; i<categoryList.length; i++){%>
        <a href="/list/<%=categoryList[i].name%>/1"><li class="category-item">ㄴ <%=categoryList[i].name%></li></a>
        <%}%>
    </ul>
  </div>
  <div class="white-bg">
    <div class="mobile-category-container">
      <div class="mobile-category-btn">
        <span id="mobile-category-btn" style="font-size: 14px;">전체 <i class="fa-solid fa-angle-down"></i></span>
      </div>
    </div>
    <%if (post?.length < 1){%>
          <div class="no-list">게시글이 없습니다.</div>
      <%} else {%>
      <% for (let i=0; i < post.length; i++){%>
        <a class="list-box-container" href="/detail/<%= post[i]._id%>">
          <div class="list-box">
            <span class="list-category"><%=post[i].categoryDetail.name%></span>
            <div style="display: flex; align-items: center">
              <span class="list-profile-img-container">
                <img id="profile-img" src="<%= post[i].author.img && post[i].author.img !== '' ? post[i].author.img : '/images/profile.png' %>" alt="">
              </span>
              <p style="margin: none; display: block; font-size: 14px;"><%= post[i].author.username%></p>
            </div>
            <h4><%= post[i].title%></h4>
            <p><%= post[i].summary != '' && post[i].summary ? post[i].summary : post[i].content%></p>
            <p style="font-size: 12.5px;"><%= new Date(post[i].createdAt).toLocaleString('ko-KR', { dateStyle: 'long', timeStyle: 'short' }) %></p>
          </div>
        </a>
    <%}}%>
  </div>
  </div>

  <div class="search-container">
    <form action="/list/search" method="GET">
      <input id="search-input" type="text" placeholder="검색어를 입력하세요." name="title">
      <button id="search-btn" class="search-btn" type="submit">검색</button>
    </form>
  </div>
  <div class="page-btn-container">
    
  <% for (let i=1; i<= post.totalPage; i++ ) { %>
      <a class="page-btn" href="/list/<%=i%>" ><%=i%></a>
  <%}%>
  </div>
<script>
  document.querySelector('#search-btn').addEventListener('click', e => {
    let value = document.querySelector('#search-input').value;
    if (value.trim().length <2){
      e.preventDefault();
      alert('두 글자 이상 입력해주세요.')
    }
  })
  document.querySelector('#mobile-category-btn').addEventListener('click', () => {
    document.querySelector('.category-container').classList.toggle('show')
  })
</script>
</body>
</html>
