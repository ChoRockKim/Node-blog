<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />

    <title>초록</title>
    <link rel="stylesheet" href="/styles/main.css" />
    <link
      rel="stylesheet"
      href="https://uicdn.toast.com/editor/latest/toastui-editor.css"
    />
  </head>
  <body class="grey-bg">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <%- include('nav.ejs')%>
    <form class="form-box" action="/newpost" , method="POST">
      <h4 style="margin-bottom: 10px; margin-top: 0">글 작성</h4>
      <p class="write-category-header">카테고리</p>
      <select class="write-category-select">
        <% for (let i=0; i < category.length; i++){%>
            <option value="<%=category[i].name%>"><%=category[i].name%></option>
          <%}%>
      </select>
      <input
        class="write-title"
        name="title"
        type="text"
        placeholder="제목을 입력해주세요"
      />
      <div id="editor"></div>
      <button class="write-submit-btn" id="submit-btn" type="submit">
        발행
      </button>
    </form>

    <!--  TOAST UI Editor CDN  -->
    <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
    <!-- 한국어 패치 -->
    <script src="https://uicdn.toast.com/editor/latest/i18n/ko-kr.min.js"></script>
    <!-- Toast UI 정의 -->
    <script>
      const getToolbarItems = () => {
        if (window.innerWidth < 768) {
          return [["bold", "italic"], ["image"], ["link"]];
        } else {
          return [
            ["heading", "bold", "italic", "strike"],
            ["hr", "quote"],
            ["image", "link"],
            ["code", "codeblock"],
          ];
        }
      };

      const Editor = toastui.Editor;
      const editor = new Editor({
        el: document.querySelector("#editor"),
        height: "600px",
        initialEditType: "markdown",
        toolbarItems: getToolbarItems(),
        previewStyle: "tab",
        placeholder: "내용을 입력해주세요",
        language: "ko-KR",
        hooks: {
          async addImageBlobHook(blob, callback) {
            console.log("이미지 업로드 됨");
            try {
              const formData = new FormData();
              formData.append("img1", blob);

              const response = await axios.post("/upload-image", formData);
              console.log(response);
              callback(response.data.url, "image");
            } catch (error) {
              if (error.response) {
                alert(error.response.data.message);
              }
            }
          },
        },
      });
      editor.on("change", () => {
        const content = editor.getMarkdown();
        const title = document.querySelector(".write-title").value;
        const tempData = {
          title,
          content,
          savedAt: new Date().toLocaleString(),
        };
        localStorage.setItem("temp_post", JSON.stringify(tempData));
      });

      window.onload = () => {
        const savedData = localStorage.getItem("temp_post");

        if (savedData) {
          const parsedData = JSON.parse(savedData);

          const confirmReceiver = confirm(
            "작성 중이던 글이 있습니다. 불러오시겠습니까?",
          );
          if (confirmReceiver) {
            document.querySelector(".write-title").value = parsedData.title;
            editor.setMarkdown(parsedData.content);
            return
          } else {
            localStorage.removeItem("temp_post");
          }
        }
      };
    </script>
    <!-- 글 작성 로직 -->
    <script>
      document.querySelector(".form-box").addEventListener("submit", (e) => {
        e.preventDefault();
      });

      document
        .querySelector("#submit-btn")
        .addEventListener("click", async () => {
          const title = document.querySelector(".write-title").value;
          const content = editor.getMarkdown();
          const category = document.querySelector(
            ".write-category-select",
          ).value;
          const formData = new FormData();
          formData.append("title", title);
          formData.append("content", content);
          formData.append("category", category);

          try {
            const { data } = await axios.post("/newpost", formData);
            alert(data.message);
            localStorage.removeItem("temp_post");
            window.location.href = "/";
          } catch (error) {
            if (error.response) {
              alert(error.response.data.message);
            }
          }
        });
    </script>
  </body>
</html>
